<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Ensure PeopleAndOrganizationsLocalPropsFile is always defined -->
  <PropertyGroup>
    <PeopleAndOrganizationsLocalPropsFile Condition="'$(PeopleAndOrganizationsLocalPropsFile)' == ''">$(MSBuildThisFileDirectory)PeopleAndOrganizations.Local.props</PeopleAndOrganizationsLocalPropsFile>
  </PropertyGroup>

  <!-- List of projects that should trigger dev mode -->
  <PropertyGroup>
    <PeopleAndOrganizationsTargetProjects>Skyline.DataMiner.Dev.Utils.Solutions.PeopleAndOrganizations;Skyline.DataMiner.Dev.Utils.Solutions.PeopleAndOrganizations.Automation;Skyline.DataMiner.Dev.Utils.Solutions.PeopleAndOrganizations.GQI;Skyline.DataMiner.Dev.Utils.Solutions.PeopleAndOrganizations.Protocol</PeopleAndOrganizationsTargetProjects>
    <IsPeopleAndOrganizationsTargetProject Condition="$(PeopleAndOrganizationsTargetProjects.Contains('$(MSBuildProjectName)'))">true</IsPeopleAndOrganizationsTargetProject>
    <IsPeopleAndOrganizationsTargetProject Condition="'$(IsPeopleAndOrganizationsTargetProject)' == ''">false</IsPeopleAndOrganizationsTargetProject>
  </PropertyGroup>

  <!-- Detect solution build using atomic counter with file locking -->
  <Target Name="DetectBuildType" BeforeTargets="BeforeBuild" Condition="'$(IsPeopleAndOrganizationsTargetProject)' == 'true'">
    <PropertyGroup>
      <PeopleAndOrganizationsBuildCounterFile>$(TEMP)\PeopleAndOrganizations_BuildCounter_$(SolutionName).txt</PeopleAndOrganizationsBuildCounterFile>
      <PeopleAndOrganizationsLockFile>$(TEMP)\PeopleAndOrganizations_BuildLock_$(SolutionName).lock</PeopleAndOrganizationsLockFile>
      <PeopleAndOrganizationsVersionIncrementedFile>$(TEMP)\PeopleAndOrganizations_VersionIncremented_$(SolutionName).txt</PeopleAndOrganizationsVersionIncrementedFile>
    </PropertyGroup>

    <!-- Use PowerShell to atomically increment counter with file locking -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$lockFile = '$(PeopleAndOrganizationsLockFile)'; $counterFile = '$(PeopleAndOrganizationsBuildCounterFile)'; $maxRetries = 50; $retryCount = 0; while ($retryCount -lt $maxRetries) { try { $lock = [System.IO.File]::Open($lockFile, 'OpenOrCreate', 'ReadWrite', 'None'); try { if (Test-Path $counterFile) { $count = [int]([System.IO.File]::ReadAllText($counterFile).Trim()) } else { $count = 0 }; $count++; [System.IO.File]::WriteAllText($counterFile, $count.ToString()); Write-Host $count; break } finally { $lock.Close(); $lock.Dispose() } } catch { Start-Sleep -Milliseconds 100; $retryCount++ } }; if ($retryCount -ge $maxRetries) { Write-Host '1' }&quot;"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="NewCount" />
    </Exec>

    <PropertyGroup>
      <NewCount>$(NewCount.Trim())</NewCount>
      
      <!-- Determine if this is a solution build (2 or more projects building) -->
      <IsBuildingSolution Condition="$(NewCount) &gt;= 2">true</IsBuildingSolution>
      <IsBuildingSolution Condition="'$(IsBuildingSolution)' == ''">false</IsBuildingSolution>
      
      <!-- Enable dev mode features only for solution builds in Debug -->
      <ShouldRunPeopleAndOrganizationsDevMode Condition="'$(PeopleAndOrganizationsLocalDevMode)' == 'true' AND '$(Configuration)' == 'Debug' AND '$(IsBuildingSolution)' == 'true'">true</ShouldRunPeopleAndOrganizationsDevMode>
      <ShouldRunPeopleAndOrganizationsDevMode Condition="'$(ShouldRunPeopleAndOrganizationsDevMode)' == ''">false</ShouldRunPeopleAndOrganizationsDevMode>
    </PropertyGroup>
    
    <Message Text="🔍 Build Detection [$(MSBuildProjectName)]:" Importance="high" />
    <Message Text="   Counter File: $(PeopleAndOrganizationsBuildCounterFile)" Importance="high" />
    <Message Text="   Build Counter: $(NewCount) / 4" Importance="high" />
    <Message Text="   IsBuildingSolution: $(IsBuildingSolution)" Importance="high" />
    <Message Text="   ShouldRunPeopleAndOrganizationsDevMode: $(ShouldRunPeopleAndOrganizationsDevMode)" Importance="high" />
    <Message Text="   PeopleAndOrganizationsVersion: $(PeopleAndOrganizationsVersion)" Importance="high" />
  </Target>

    <!-- Auto-increment version (only once per solution build) -->
    <Target Name="IncrementPeopleAndOrganizationsVersion"
            BeforeTargets="BeforeBuild"
            AfterTargets="DetectBuildType"
            Condition="'$(ShouldRunPeopleAndOrganizationsDevMode)' == 'true'">

        <PropertyGroup>
            <PeopleAndOrganizationsVersionIncrementedFile>$(TEMP)\PeopleAndOrganizations_VersionIncremented_$(SolutionName).txt</PeopleAndOrganizationsVersionIncrementedFile>
            <VersionAlreadyIncremented Condition="Exists('$(PeopleAndOrganizationsVersionIncrementedFile)')">true</VersionAlreadyIncremented>
            <VersionAlreadyIncremented Condition="'$(VersionAlreadyIncremented)' == ''">false</VersionAlreadyIncremented>
        </PropertyGroup>

        <CallTarget Targets="IncrementPeopleAndOrganizationsVersionInternal" Condition="'$(VersionAlreadyIncremented)' == 'false'" />
    </Target>

  <!-- Clean up counter files ONLY after last project (count = 4) -->
  <Target Name="CleanupBuildCounterAfterLastProject" AfterTargets="AfterBuild" Condition="'$(IsPeopleAndOrganizationsTargetProject)' == 'true'">
    <PropertyGroup>
      <PeopleAndOrganizationsBuildCounterFile>$(TEMP)\PeopleAndOrganizations_BuildCounter_$(SolutionName).txt</PeopleAndOrganizationsBuildCounterFile>
      <PeopleAndOrganizationsLockFile>$(TEMP)\PeopleAndOrganizations_BuildLock_$(SolutionName).lock</PeopleAndOrganizationsLockFile>
      <PeopleAndOrganizationsVersionIncrementedFile>$(TEMP)\PeopleAndOrganizations_VersionIncremented_$(SolutionName).txt</PeopleAndOrganizationsVersionIncrementedFile>
    </PropertyGroup>

    <!-- Use PowerShell to atomically read counter and clean up if count = 4 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$lockFile = '$(PeopleAndOrganizationsLockFile)'; $counterFile = '$(PeopleAndOrganizationsBuildCounterFile)'; $versionFile = '$(PeopleAndOrganizationsVersionIncrementedFile)'; $maxRetries = 50; $retryCount = 0; while ($retryCount -lt $maxRetries) { try { $lock = [System.IO.File]::Open($lockFile, 'Open', 'ReadWrite', 'None'); try { if (Test-Path $counterFile) { $count = [int]([System.IO.File]::ReadAllText($counterFile).Trim()); if ($count -ge 4) { Start-Sleep -Milliseconds 500; Remove-Item -Path $counterFile,$lockFile,$versionFile -Force -ErrorAction SilentlyContinue; Write-Host 'Cleaned up' } } break } finally { $lock.Close(); $lock.Dispose() } } catch { Start-Sleep -Milliseconds 100; $retryCount++ } }&quot;"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="true" />
  </Target>

  <Target Name="IncrementPeopleAndOrganizationsVersionInternal" AfterTargets="AfterBuild"  Condition="'$(IsPeopleAndOrganizationsTargetProject)' == 'true' and $(NewCount) == '4' and '$(ShouldRunPeopleAndOrganizationsDevMode)' == 'true' and '$(VersionAlreadyIncremented)' == 'false'">
    <!-- Ensure all required properties are defined -->
    <PropertyGroup>
      <PeopleAndOrganizationsLocalPropsFile Condition="'$(PeopleAndOrganizationsLocalPropsFile)' == ''">$(MSBuildThisFileDirectory)PeopleAndOrganizations.Local.props</PeopleAndOrganizationsLocalPropsFile>
      <PeopleAndOrganizationsVersionIncrementedFile Condition="'$(PeopleAndOrganizationsVersionIncrementedFile)' == ''">$(TEMP)\PeopleAndOrganizations_VersionIncremented_$(SolutionName).txt</PeopleAndOrganizationsVersionIncrementedFile>
    </PropertyGroup>

    <!-- Only proceed if the local props file exists -->
    <Error Text="❌ PeopleAndOrganizations.Local.props file not found at: $(PeopleAndOrganizationsLocalPropsFile)" 
           Condition="!Exists('$(PeopleAndOrganizationsLocalPropsFile)')" />

    <!-- Parse current version -->
    <PropertyGroup>
      <CurrentVersion>$(PeopleAndOrganizationsVersion)</CurrentVersion>
      <VersionMajor>$([System.Text.RegularExpressions.Regex]::Match($(CurrentVersion), '^(\d+)\.').Groups[1].Value)</VersionMajor>
      <VersionMinor>$([System.Text.RegularExpressions.Regex]::Match($(CurrentVersion), '^\d+\.(\d+)\.').Groups[1].Value)</VersionMinor>
      <VersionPatch>$([System.Text.RegularExpressions.Regex]::Match($(CurrentVersion), '^\d+\.\d+\.(\d+)\.').Groups[1].Value)</VersionPatch>
      <VersionBuild>$([System.Text.RegularExpressions.Regex]::Match($(CurrentVersion), '^\d+\.\d+\.\d+\.(\d+)').Groups[1].Value)</VersionBuild>
      
      <!-- Increment build number -->
      <NewVersionBuild>$([MSBuild]::Add($(VersionBuild), 1))</NewVersionBuild>
      <NewVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).$(NewVersionBuild)</NewVersion>
    </PropertyGroup>

    <!-- Read and update the local props file -->
    <PropertyGroup>
      <LocalPropsContent>$([System.IO.File]::ReadAllText('$(PeopleAndOrganizationsLocalPropsFile)'))</LocalPropsContent>
      <UpdatedPropsContent>$(LocalPropsContent.Replace('&lt;PeopleAndOrganizationsVersion&gt;$(CurrentVersion)&lt;/PeopleAndOrganizationsVersion&gt;', '&lt;PeopleAndOrganizationsVersion&gt;$(NewVersion)&lt;/PeopleAndOrganizationsVersion&gt;'))</UpdatedPropsContent>
    </PropertyGroup>

    <!-- Write back to file -->
    <WriteLinesToFile File="$(PeopleAndOrganizationsLocalPropsFile)" 
                      Lines="$(UpdatedPropsContent)" 
                      Overwrite="true" 
                      Encoding="UTF-8" />
    
    <!-- Create marker file to prevent duplicate increments -->
    <WriteLinesToFile File="$(PeopleAndOrganizationsVersionIncrementedFile)" 
                      Lines="$(NewVersion)" 
                      Overwrite="true" 
                      Encoding="UTF-8" />

    <!-- Update property for current build -->
    <PropertyGroup>
      <PeopleAndOrganizationsVersion>$(NewVersion)</PeopleAndOrganizationsVersion>
    </PropertyGroup>

    <Message Text="🚀 PeopleAndOrganizations Version Incremented: $(CurrentVersion) → $(NewVersion)" Importance="high" />
  </Target>

  <!-- Disable NuGet generation for individual project builds -->
  <Target Name="DisableNuGetForProjectBuild" 
          BeforeTargets="GenerateNuspec"
          Condition="'$(ShouldRunPeopleAndOrganizationsDevMode)' != 'true'">
    <PropertyGroup>
      <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
      <IsPackable>false</IsPackable>
    </PropertyGroup>
    <Message Text="⛔ NuGet generation disabled (individual project build or not Debug config)" Importance="high" />
  </Target>

  <!-- Copy NuGet packages after pack - ALSO copy for first project (counter=1) -->
  <Target Name="CopyPeopleAndOrganizationsNuGetPackage" 
          AfterTargets="Pack" 
          Condition="'$(IsPeopleAndOrganizationsTargetProject)' == 'true' AND '$(PeopleAndOrganizationsNuGetOutputPath)' != '' AND ('$(ShouldRunPeopleAndOrganizationsDevMode)' == 'true' OR ('$(IsBuildingSolution)' == 'false' AND '$(Configuration)' == 'Debug' AND '$(PeopleAndOrganizationsLocalDevMode)' == 'true'))">
    <PropertyGroup>
      <NuGetPackageFile>$(OutputPath)..\$(PackageId).$(PackageVersion).nupkg</NuGetPackageFile>
    </PropertyGroup>
    
    <MakeDir Directories="$(PeopleAndOrganizationsNuGetOutputPath)" Condition="!Exists('$(PeopleAndOrganizationsNuGetOutputPath)')" />
    <Copy SourceFiles="$(NuGetPackageFile)" 
          DestinationFolder="$(PeopleAndOrganizationsNuGetOutputPath)" 
          Condition="Exists('$(NuGetPackageFile)')" />
    
    <Message Text="📦 Copied $(PackageId).$(PackageVersion).nupkg → $(PeopleAndOrganizationsNuGetOutputPath)" 
             Importance="high" 
             Condition="Exists('$(NuGetPackageFile)')" />
  </Target>
</Project>